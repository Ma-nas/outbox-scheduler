generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String?
  name            String
  avatar          String?
  googleId        String?  @unique
  slackWebhookUrl String?
  slackChannel    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  emails          Email[]
}

model SenderAccount {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  smtpHost  String   @default("smtp.ethereal.email")
  smtpPort  Int      @default(587)
  smtpUser  String?
  smtpPass  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  emails    Email[]
}

model Email {
  id              String         @id @default(cuid())
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  senderId        String?
  senderAccount   SenderAccount? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  sender          String         @default("outbox-agent-1@reachinbox.ai")
  recipient       String
  subject         String
  body            String
  status          String         @default("SCHEDULED") // SCHEDULED, PROCESSING, SENT, FAILED, CANCELLED, RATE_LIMITED
  scheduledAt     DateTime
  sentAt          DateTime?
  failedAt        DateTime?
  errorReason     String?
  previewUrl      String?        // Ethereal preview link
  messageId       String?        // SMTP Message ID
  jobId           String?        // BullMQ Job ID
  attempts        Int            @default(0)
  minDelaySeconds Int            @default(2)
  hourlyLimit     Int            @default(200)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([sender])
}
