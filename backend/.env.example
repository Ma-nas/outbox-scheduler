# ReachInbox Outbox Email Scheduler Environment Configuration

# Server Port
PORT=5000

# Persistent Relational Database (SQLite by default, or postgresql://user:password@localhost:5432/reachinbox)
DATABASE_URL="file:./dev.db"

# Redis Server (Used by BullMQ for Queue state & rate limiting counters)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Secret
JWT_SECRET=reachinbox_super_secret_jwt_key_2026

# Ethereal Email SMTP (Fake SMTP for Testing)
# Leave blank to automatically generate disposable Ethereal test accounts on startup!
ETH_USER=
ETH_PASS=
ETH_HOST=smtp.ethereal.email
ETH_PORT=587

# Worker Concurrency (Number of parallel BullMQ jobs processed by worker)
WORKER_CONCURRENCY=5

# Provider Throttling: Minimum Delay Between Individual Email Sends (in milliseconds)
# Example: 2000ms = 2 seconds minimum between sends to mimic provider throttling
MIN_DELAY_BETWEEN_EMAILS_MS=2000

# Rate Limiting: Max Emails Allowed Per Hour Per Sender
# When this hourly limit is reached, jobs are safely rescheduled into the next hour window
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Global Token Bucket Limiter for BullMQ
RATE_LIMIT_MAX=10
RATE_LIMIT_DURATION_MS=1000

# Elasticsearch Cluster URL (Optional - automatic in-app fallback search if offline)
ELASTICSEARCH_URL=http://localhost:9200

# Slack Incoming Webhook / Bot Alert URL (Sends live notification when hourly rate limit is hit)
# Leave blank or provide your Slack webhook URL (e.g. from Slack App Incoming Webhooks)
SLACK_WEBHOOK_URL=
