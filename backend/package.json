{
  "name": "reachinbox-outbox-backend",
  "version": "1.0.0",
  "description": "ReachInbox Outbox Email Scheduling Backend with TypeScript, Express, BullMQ, Redis, Elasticsearch & Ethereal SMTP",
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "redis": "bin\\redis-server.exe",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "tsx src/prisma/seed.ts"
  },
  "keywords": [
    "email",
    "scheduler",
    "bullmq",
    "redis",
    "outbox",
    "express",
    "reachinbox",
    "elasticsearch",
    "slack"
  ],
  "author": "ReachInbox Outbox Labs",
  "license": "MIT",
  "dependencies": {
    "@bull-board/api": "^6.7.13",
    "@bull-board/express": "^6.7.13",
    "@elastic/elasticsearch": "^8.17.0",
    "@prisma/client": "^5.22.0",
    "@slack/web-api": "^7.8.0",
    "axios": "^1.21.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
